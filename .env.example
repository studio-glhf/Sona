# Enter Sona's project API key in Settings. It stays in memory until restart.
# Variables below are optional server or independent-runtime settings.
# Keep private environment files outside the repository.
# Sona does not copy the coding assistant's connections or credentials.
# Optional legacy seed; not required when you use Sona Settings.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
# Admin operations use this separate optional key.
OPENAI_ADMIN_KEY=
# Optional direct Google Calendar OAuth credentials and test resource.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
# Default: OS application-data directory. Never use the repository.
# SONA_DATA_DIR=
SONA_PORT=4317
